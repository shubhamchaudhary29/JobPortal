# Copy this file to .env and replace every required placeholder locally.
# Never commit .env. All variables below are backend-only; none should use VITE_.

# Required: MongoDB connection including database name.
# For Docker Compose, use: mongodb://mongodb:27017/jobportal
# For a locally running backend, use: mongodb://localhost:27017/jobportal
MONGODB_URI=REPLACE_WITH_MONGODB_URI

# Required: at least 32 random bytes of secret material. Backend-only.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Cookies must be Secure outside local HTTP development.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Strict

# Per-instance authentication throttling.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ENTRIES=10000

# Required Adzuna credentials. Backend-only.
ADZUNA_APP_ID=REPLACE_WITH_ADZUNA_APP_ID
ADZUNA_APP_KEY=REPLACE_WITH_ADZUNA_APP_KEY
ADZUNA_CONNECT_TIMEOUT_MS=3000
ADZUNA_READ_TIMEOUT_MS=5000
ADZUNA_RETRY_MAX_ATTEMPTS=3
ADZUNA_RETRY_INITIAL_BACKOFF_MS=200
ADZUNA_CIRCUIT_FAILURE_THRESHOLD=3
ADZUNA_CIRCUIT_OPEN_MS=60000
ADZUNA_PAGES_PER_KEYWORD=2
ADZUNA_RESULTS_PER_PAGE=20
ADZUNA_MONTHLY_REQUEST_BUDGET=2000
# Jooble stays disabled while JOOBLE_API_KEY is empty. Use a key from the regional domain (in.jooble.org for India).
JOOBLE_API_KEY=
JOOBLE_BASE_URL=https://in.jooble.org/api
JOOBLE_KEYWORDS=software engineer,data analyst,product manager
JOOBLE_LOCATION=India
JOOBLE_PAGES_PER_KEYWORD=1
JOOBLE_RESULTS_PER_PAGE=20
JOOBLE_MONTHLY_REQUEST_BUDGET=100
JOOBLE_SCHEDULE_DELAY_MS=86400000
ADZUNA_KEYWORDS=java developer,python developer,react developer,data analyst,backend engineer,frontend developer,full stack developer,machine learning engineer,software engineer,devops engineer,product manager,business analyst
# Each keyword runs country-wide and in every city; plans larger than one run rotate across runs.
ADZUNA_CITIES=Bengaluru,Delhi,Gurugram,Noida,Mumbai,Pune,Hyderabad,Chennai,Kolkata,Ahmedabad
# 0 derives the per-run request allowance from ADZUNA_MONTHLY_REQUEST_BUDGET and ADZUNA_SCHEDULE_DELAY_MS.
ADZUNA_REQUESTS_PER_RUN=0
ADZUNA_MIN_REQUEST_INTERVAL_MS=2500
MONGO_INDEX_VERIFY_ON_STARTUP=true

# Disable all automated external collection in tests and local development as needed.
JOB_AGGREGATION_SCHEDULING_ENABLED=false
GREENHOUSE_SYNC_DELAY_MS=21600000
LEVER_SYNC_DELAY_MS=21600000
ASHBY_SYNC_DELAY_MS=21600000
SMARTRECRUITERS_SYNC_DELAY_MS=21600000
WORKABLE_SYNC_DELAY_MS=21600000
ADZUNA_SCHEDULE_DELAY_MS=43200000
JOB_AGGREGATION_LOCK_LEASE_MS=300000
JOB_AGGREGATION_LOCK_RENEWAL_MS=60000
JOB_AGGREGATION_SYNC_HISTORY_RETENTION_DAYS=30
JOB_AGGREGATION_PROVIDER_CONNECT_TIMEOUT_MS=3000
JOB_AGGREGATION_PROVIDER_READ_TIMEOUT_MS=5000
JOB_AGGREGATION_PROVIDER_RETRY_MAX_ATTEMPTS=3
JOB_AGGREGATION_PROVIDER_RETRY_INITIAL_BACKOFF_MS=200
JOB_AGGREGATION_PROVIDER_RETRY_MAX_BACKOFF_MS=5000
JOB_AGGREGATION_PROVIDER_MAX_RESPONSE_BYTES=2097152
JOB_AGGREGATION_PROVIDER_MAX_ITEMS=2000
JOB_AGGREGATION_PROVIDER_REQUESTS_PER_SECOND=5
JOB_AGGREGATION_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
JOB_AGGREGATION_PROVIDER_CIRCUIT_OPEN_MS=60000
GREENHOUSE_BASE_URL=https://boards-api.greenhouse.io/v1/boards
LEVER_BASE_URL=https://api.lever.co/v0/postings
ASHBY_BASE_URL=https://api.ashbyhq.com/posting-api/job-board
SMARTRECRUITERS_BASE_URL=https://api.smartrecruiters.com/v1/companies
WORKABLE_BASE_URL=https://apply.workable.com/api/v1/widget/accounts
SMARTRECRUITERS_PAGE_SIZE=100
SMARTRECRUITERS_MAX_PAGES=20
SMARTRECRUITERS_MAX_DETAIL_REQUESTS=100
SMARTRECRUITERS_DETAIL_RETENTION_DAYS=30
JOB_AGGREGATION_MISSING_THRESHOLD=3
# The employer registry lives in Mongo (employer_registry); properties seed it idempotently at startup.
JOB_AGGREGATION_REGISTRY_IMPORT_ON_STARTUP=true
JOB_AGGREGATION_REGISTRY_MAX_EMPLOYERS_PER_RUN=2000
JOB_AGGREGATION_RETENTION_DAYS=90
JOB_AGGREGATION_CLEANUP_BATCH_SIZE=100
JOB_AGGREGATION_CLEANUP_LOCK_LEASE_MS=300000
JOB_AGGREGATION_CLEANUP_CRON=0 30 2 * * *

# Deterministic candidate/job matching. Weights must total 100.
MATCHING_SKILLS_WEIGHT=40
MATCHING_EXPERIENCE_WEIGHT=20
MATCHING_TITLE_WEIGHT=15
MATCHING_EDUCATION_WEIGHT=10
MATCHING_LOCATION_WEIGHT=10
MATCHING_EMPLOYMENT_TYPE_WEIGHT=5
MATCHING_CANDIDATE_WINDOW=500

# Required comma-separated browser origins; do not use * with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Optional non-sensitive upload limits.
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=6MB
RESUME_MAX_BYTES=5242880
CANDIDATE_RESUME_MAX_BYTES=5242880
CANDIDATE_RESUME_ALLOWED_FORMATS=pdf,docx

# Disable API docs in production unless intentionally exposed.
SWAGGER_ENABLED=true

# --- Container memory (GEO-0) ---
# Sizing: backend ~45% of host RAM, mongo ~35%, WiredTiger cache ~40% of mongo limit (min 0.25).
# Defaults below assume a ~2 GB host.
BACKEND_MEM_LIMIT=1g
MONGO_MEM_LIMIT=768m
MONGO_WT_CACHE_GB=0.25

# --- Map tiles (GEO-4) ---
# Host directory with manifest.json, the India .pmtiles and fonts/sprites (build with frontend/scripts/build-tiles.sh).
TILES_DIR=./tiles
