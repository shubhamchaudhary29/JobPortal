# Copy this file to .env and replace every required placeholder locally.
# Never commit .env. All variables below are backend-only; none should use VITE_.

# Required: MongoDB connection including database name.
# For Docker Compose, use: mongodb://mongodb:27017/jobportal
# For a locally running backend, use: mongodb://localhost:27017/jobportal
MONGODB_URI=REPLACE_WITH_MONGODB_URI

# Required: at least 32 random bytes of secret material. Backend-only.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Cookies must be Secure outside local HTTP development.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Strict

# Per-instance authentication throttling.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ENTRIES=10000

# Required Adzuna credentials. Backend-only.
ADZUNA_APP_ID=REPLACE_WITH_ADZUNA_APP_ID
ADZUNA_APP_KEY=REPLACE_WITH_ADZUNA_APP_KEY
ADZUNA_CONNECT_TIMEOUT_MS=3000
ADZUNA_READ_TIMEOUT_MS=5000
ADZUNA_RETRY_MAX_ATTEMPTS=3
ADZUNA_RETRY_INITIAL_BACKOFF_MS=200
ADZUNA_CIRCUIT_FAILURE_THRESHOLD=3
ADZUNA_CIRCUIT_OPEN_MS=60000
ADZUNA_SCHEDULE_CRON=0 0 */6 * * *
ADZUNA_PAGES_PER_KEYWORD=2
ADZUNA_RESULTS_PER_PAGE=20
ADZUNA_KEYWORDS=java developer,python developer,react developer
MONGO_INDEX_VERIFY_ON_STARTUP=true

# Required comma-separated browser origins; do not use * with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Optional non-sensitive upload limits.
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=5MB
RESUME_MAX_BYTES=5242880

# Disable API docs in production unless intentionally exposed.
SWAGGER_ENABLED=true

# Disable periodic Adzuna imports in isolated test environments.
APP_SCHEDULING_ENABLED=true
